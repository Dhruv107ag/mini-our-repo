# Local development environment variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lnmiit_lab_management
DB_USER=root
DB_PASSWORD=

# App URL
APP_URL=http://localhost:3000

# Set to true to authenticate via MySQL database, or false for offline/mock demo mode
USE_DB_AUTH=true

# Feature flags
NEXT_PUBLIC_MULTI_STAFF_UI=false
NEXT_PUBLIC_FORGOT_REQUIRE_TYPE=true

# Email Notifications (Testing mode logs to console instead of sending real emails)
TESTING_MODE=true
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

